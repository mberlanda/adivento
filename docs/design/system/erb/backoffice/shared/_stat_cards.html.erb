<%#
  Adivento DS — backoffice stat cards row
  Usage: <%= render "backoffice/shared/stat_cards", stats: [
            ["Open markets", 34], ["24h volume", "1.2M"],
            ["Pending faucet", 7], ["To settle", 3] ] %>
%>
<div class="adv-grid adv-grid--4">
  <% stats.each do |label, value| %>
    <div class="adv-statcard">
      <div class="adv-stat__k"><%= label %></div>
      <div class="adv-statcard__v adv-num"><%= value %></div>
    </div>
  <% end %>
</div>
