<%#
  Adivento DS — backoffice sidebar
  Usage (in layouts/backoffice.html.erb, inside a .ds-shell wrapper):
    <div class="ds-shell ds-app">
      <%= render "backoffice/shared/sidebar", current: :markets %>
      <main class="ds-main"><%= yield %></main>
    </div>
  Locals:
    current: :markets | :create | :settle | :faucet | :rbac | nil
%>
<%
  current ||= nil
  nav = [
    [:overview, "Overview", "▤", "#"],
    [:markets,  "Markets",  "▦", backoffice_markets_path],
    [:create,   "Create",   "＋", "#"],
    [:settle,   "Settle",   "⚖︎", "#"],
    [:faucet,   "Faucet",   "⛲", "#"],
    [:rbac,     "Access",   "🛡", "#"],
  ]
%>
<aside class="ds-sidebar">
  <div class="ds-sidebar__brand"><span class="ds-nav__mark"></span> Console</div>
  <div class="ds-sidebar__section">Operate</div>
  <% nav.each do |key, label, icon, path| %>
    <%= link_to path, class: "ds-sidebar__link #{'is-active' if current == key}" do %>
      <span class="ds-sidebar__icon"><%= icon %></span> <%= label %>
    <% end %>
  <% end %>
  <span class="ds-spacer"></span>
  <button class="ds-btn ds-btn--ghost ds-btn--sm ds-btn--block" data-ds-theme-toggle>
    ◑ <span data-ds-theme-label>Light</span>
  </button>
</aside>
