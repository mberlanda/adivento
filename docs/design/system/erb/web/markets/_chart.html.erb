<%#
  Adivento DS — price history chart + decision stats
  Usage: <%= render "web/markets/chart", points: market.price_history,
                     value: market.yes_pct, delta_label: "4 pts today",
                     stats: [["24h volume","24,180"],["Liquidity","88,400"],
                             ["Holders","146"],["24h trades","512"]] %>
  Locals:
    points: Array<Numeric 0-100> (price history) — rendered by adivento.js
    value:  current YES chance (Numeric)
    delta_label: String (optional)
    stats:  Array of [key, value] pairs
    height: px (default 170)
%>
<%
  height ||= 170
  delta_label = defined?(delta_label) ? delta_label : nil
  stats ||= []
%>
<div class="ds-card">
  <div class="ds-row ds-row--between" style="margin-bottom:12px">
    <div class="ds-row" style="align-items:baseline;gap:10px">
      <span class="ds-num" style="font-size:30px;font-weight:800;color:var(--ds-accent)" data-live-pct><%= value %>%</span>
      <% if delta_label %><span class="ds-delta ds-delta--up"><%= delta_label %></span><% end %>
      <span class="ds-muted ds-xs">YES chance</span>
    </div>
    <span class="ds-badge ds-badge--open ds-badge--live">live · SSE</span>
  </div>

  <div class="ds-chart" style="height: <%= height %>px" data-ds-live data-value="<%= value %>">
    <svg data-ds-chart="<%= points.join(',') %>" aria-hidden="true"></svg>
    <span class="ds-chart__axis ds-chart__axis--top">100%</span>
    <span class="ds-chart__axis ds-chart__axis--bottom">0%</span>
  </div>
  <div class="ds-chart-frames">
    <% %w[1H 6H 1D 1W ALL].each_with_index do |f, i| %>
      <span class="ds-chip <%= 'is-active' if i == 2 %>"><%= f %></span>
    <% end %>
  </div>

  <% if stats.any? %>
    <div class="ds-stats" style="margin-top:16px;border-top:1.5px solid var(--ds-faint);padding-top:14px">
      <% stats.each do |k, v| %>
        <div class="ds-stat">
          <div class="ds-stat__k"><%= k %></div>
          <div class="ds-stat__v ds-num"><%= v %></div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
