<%#
  Adivento DS — YES / NO price boxes
  Usage: <%= render "web/markets/price_boxes", yes_pct: 62, no_pct: 38,
                     yes_payout: "1.61×", no_payout: "2.63×", selected: :yes,
                     suffix: "%" %>
  Locals:
    yes_pct, no_pct: Numeric
    yes_payout, no_payout: String (optional sub-line)
    selected: :yes | :no | nil
    suffix: "%" or "¢"
  The data-price attribute feeds Adivento.ticket payout math (cents).
%>
<%
  suffix     ||= "%"
  selected   = defined?(selected) ? selected : :yes
  yes_payout = defined?(yes_payout) ? yes_payout : nil
  no_payout  = defined?(no_payout)  ? no_payout  : nil
%>
<div class="adv-prices">
  <div class="adv-pricebox adv-pricebox--yes <%= 'is-selected' if selected == :yes %>" data-price="<%= yes_pct %>">
    <div class="adv-pricebox__label">Yes</div>
    <div class="adv-pricebox__val adv-num"><%= yes_pct %><%= suffix %></div>
    <% if yes_payout %><div class="adv-pricebox__sub">pays <%= yes_payout %></div><% end %>
  </div>
  <div class="adv-pricebox adv-pricebox--no <%= 'is-selected' if selected == :no %>" data-price="<%= no_pct %>">
    <div class="adv-pricebox__label">No</div>
    <div class="adv-pricebox__val adv-num"><%= no_pct %><%= suffix %></div>
    <% if no_payout %><div class="adv-pricebox__sub">pays <%= no_payout %></div><% end %>
  </div>
</div>
