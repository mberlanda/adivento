<%#
  Adivento DS — customer top nav
  Usage (in layouts/application.html.erb, inside <body class="ds-app">):
    <%= render "web/shared/nav", current: :markets, balance: current_user&.balance %>
  Locals:
    current: :markets | :communities | :leaderboard | nil
    balance: Numeric or nil (guest)
%>
<%
  current ||= nil
  balance = defined?(balance) ? balance : nil
  links = [[:markets, "Markets", web_markets_path],
           [:communities, "Communities", "#"],
           [:leaderboard, "Leaderboard", web_leaderboard_path]]
%>
<header class="ds-nav">
  <%= link_to web_markets_path, class: "ds-nav__brand", style: "text-decoration:none" do %>
    <span class="ds-nav__mark"></span> Adivento
  <% end %>

  <nav class="ds-nav__links ds-hide-mobile">
    <% links.each do |key, label, path| %>
      <%= link_to label, path, class: "ds-nav__link #{'is-active' if current == key}" %>
    <% end %>
  </nav>

  <span class="ds-spacer"></span>

  <% if balance %>
    <span class="ds-balance ds-hide-mobile"><%= number_with_delimiter(balance) %> <small>ADIV</small></span>
  <% end %>

  <button class="ds-btn ds-btn--ghost ds-btn--sm" data-ds-theme-toggle aria-pressed="false" aria-label="Toggle theme">
    ◑ <span data-ds-theme-label>Light</span>
  </button>

  <% if balance %>
    <%= link_to "#", class: "ds-avatar ds-avatar--sm", "aria-label": "Profile" do %><% end %>
  <% else %>
    <%= render "shared/adv_button", label: "Sign in", variant: "primary", size: "sm", href: "#" %>
  <% end %>
</header>
