<h1 data-testid="backoffice-markets-title">Markets</h1>

<div class="panel">
  <h3>Create Market</h3>
  <%= form_with url: backoffice_markets_path, method: :post, html: { data: { testid: "create-market-form" } } do |f| %>
    <p><label>Question</label><br><%= text_field_tag :question, nil, required: true, data: { testid: "market-question" } %></p>
    <p><label>Description</label><br><%= text_area_tag :description, nil, required: true, data: { testid: "market-description" } %></p>
    <p><label>Legs (comma separated, default: YES,NO)</label><br><%= text_field_tag :legs, "YES,NO", data: { testid: "market-legs" } %></p>
    <p>
      <label>Category</label><br>
      <%= select_tag :category,
            options_for_select(Market::CATEGORIES.map { |c| [c.capitalize, c] }, "other"),
            data: { testid: "market-category" } %>
    </p>
    <p><label>Tags (comma-separated, optional)</label><br><%= text_field_tag :tags_input, nil, placeholder: "nba, fed, ai", data: { testid: "market-tags" } %></p>
    <p><label>Close date/time (optional)</label><br><%= datetime_local_field_tag :close_at, nil, data: { testid: "market-close-at" } %></p>
    <p><label>Resolution criteria <small>(what constitutes a YES outcome?)</small></label><br><%= text_area_tag :resolution_criteria, nil, rows: 3, placeholder: "e.g. YES resolves if the Federal Reserve announces a rate reduction at this meeting.", data: { testid: "market-resolution-criteria" } %></p>
    <p><label>Resolution source <small>(authoritative source for outcome)</small></label><br><%= text_field_tag :resolution_source, nil, placeholder: "e.g. Federal Reserve official statement", data: { testid: "market-resolution-source" } %></p>
    <p>
      <label>Market Mechanism</label><br>
      <%= select_tag :mechanism_type,
            options_for_select([
              ["Fixed-odds (house underwriting)", "fixed_odds"],
              ["CLOB (limit order book)", "clob"],
              ["LMSR (automated market maker)", "lmsr"],
              ["Parimutuel (pool-share)", "parimutuel"]
            ], "fixed_odds"),
            id: "mechanism_type_select",
            data: { testid: "market-mechanism-type" } %>
    </p>

    <div id="fixed_odds_fields">
      <p><label>Fee (basis points, 100 = 1%)</label><br><%= number_field_tag :fee_bps, 100, min: 0, data: { testid: "market-fee-bps" } %></p>
      <p><label>Liability Cap (minor units)</label><br><%= number_field_tag :liability_cap_minor, 100000, min: 1, data: { testid: "market-liability-cap" } %></p>
    </div>

    <div id="clob_fields" style="display:none;">
      <p><label>Taker fee (basis points, 0–200)</label><br><%= number_field_tag :taker_fee_bps, 70, min: 0, max: 200 %></p>
    </div>

    <div id="lmsr_fields" style="display:none;">
      <p><label>Initial subsidy (ADIV minor units)</label><br><%= number_field_tag :liquidity_subsidy_minor, 100000, min: 1 %></p>
      <p><label>Spread fee (basis points, 0–500)</label><br><%= number_field_tag :spread_fee_bps, 100, min: 0, max: 500 %></p>
    </div>

    <div id="parimutuel_fields" style="display:none;">
      <p><label>Takeout (basis points, 1000–3000)</label><br><%= number_field_tag :takeout_bps, 1500, min: 1000, max: 3000 %></p>
    </div>

    <script>
      document.getElementById('mechanism_type_select').addEventListener('change', function() {
        ['fixed_odds', 'clob', 'lmsr', 'parimutuel'].forEach(function(m) {
          document.getElementById(m + '_fields').style.display = 'none';
        });
        document.getElementById(this.value + '_fields').style.display = 'block';
      });
    </script>

    <p><%= submit_tag "Create market", data: { testid: "market-create-submit" } %></p>
  <% end %>
</div>

<div class="panel">
  <h3>All Markets</h3>
  <% if @markets.any? %>
    <table data-testid="markets-table">
      <thead>
        <tr>
          <th>ID</th><th>Question</th><th>Status</th><th>Category</th><th>Created by</th><th>Created</th><th></th>
        </tr>
      </thead>
      <tbody>
        <% @markets.each do |market| %>
          <tr data-testid="market-row-<%= market.id %>">
            <td><%= market.id %></td>
            <td><%= market.question.truncate(60) %></td>
            <td style="text-transform:uppercase;font-size:0.8em;"><%= market.status %></td>
            <td style="font-size:0.8em;"><%= market.category %></td>
            <td><%= market.created_by.email %></td>
            <td><%= market.created_at.strftime("%Y-%m-%d") %></td>
            <td><%= link_to "View", backoffice_market_path(market), style: "color:#f0bc5c;text-decoration:none;" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p style="color:#9fb2b8;">No markets yet. Create one above or via a template.</p>
  <% end %>
</div>
