<h1>Faucet Requests</h1>

<div class="ds-card ds-card--flush" style="margin-bottom:16px;">
  <div class="ds-card__head"><h2 style="margin:0;font-size:1.1rem;">Pending (<%= @pending.count %>)</h2></div>
  <% if @pending.any? %>
    <table class="ds-table">
      <thead>
        <tr>
          <th>Player</th>
          <th style="text-align:right;">Amount (ADIV)</th>
          <th>Requested at</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @pending.each do |req| %>
          <tr>
            <td class="ds-muted"><%= req.user.email %></td>
            <td class="ds-num" style="text-align:right;"><%= number_with_delimiter(req.amount_minor) %></td>
            <td class="ds-muted ds-xs"><%= req.created_at.strftime("%Y-%m-%d %H:%M") %></td>
            <td>
              <%= button_to "Approve",
                    approve_backoffice_faucet_request_path(req),
                    method: :post,
                    class: "ds-btn ds-btn--primary ds-btn--sm",
                    data: { testid: "approve-#{req.id}" } %>
              <%= button_to "Reject",
                    reject_backoffice_faucet_request_path(req),
                    method: :post,
                    class: "ds-btn ds-btn--danger ds-btn--sm",
                    data: { testid: "reject-#{req.id}" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="ds-muted" style="padding:16px;">No pending faucet requests.</p>
  <% end %>
</div>

<div class="ds-card ds-card--flush">
  <div class="ds-card__head"><h2 style="margin:0;font-size:1.1rem;">Recently Processed</h2></div>
  <% if @processed.any? %>
    <table class="ds-table">
      <thead>
        <tr>
          <th>Player</th>
          <th style="text-align:right;">Amount</th>
          <th>Status</th>
          <th>Reviewed by</th>
          <th>Processed at</th>
        </tr>
      </thead>
      <tbody>
        <% @processed.each do |req| %>
          <tr>
            <td class="ds-muted"><%= req.user.email %></td>
            <td class="ds-num" style="text-align:right;"><%= number_with_delimiter(req.amount_minor) %></td>
            <td><%= render "shared/adv_badge", status: req.status %></td>
            <td class="ds-muted"><%= req.reviewed_by&.email %></td>
            <td class="ds-muted ds-xs"><%= req.updated_at.strftime("%Y-%m-%d %H:%M") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="ds-muted" style="padding:16px;">No processed requests.</p>
  <% end %>
</div>
