<h1>Operations Dashboard</h1>
<div class="ds-grid ds-grid--auto" style="margin-top:16px;">
  <div class="ds-statcard">
    <div class="ds-stat__k">Open markets</div>
    <div class="ds-statcard__v ds-num"><%= @open_markets %></div>
  </div>
  <div class="ds-statcard">
    <div class="ds-stat__k">Pending faucet requests</div>
    <div class="ds-statcard__v ds-num"><%= @pending_faucet_requests %></div>
  </div>
  <div class="ds-statcard">
    <div class="ds-stat__k">Active templates</div>
    <div class="ds-statcard__v ds-num"><%= @active_templates %></div>
  </div>
</div>
