<%#
  Backoffice sidebar. Locals:
    current: :markets | :dashboard | :faucet | :grants | :templates | :permissions | nil
%>
<%
  current ||= nil
  nav = [
    [:dashboard,   "Dashboard",       "▤", backoffice_root_path],
    [:markets,     "Markets",         "▦", backoffice_markets_path],
    [:faucet,      "Faucet Requests", "⛲", backoffice_faucet_requests_path],
    [:grants,      "Grants",          "✦", backoffice_grants_path],
    [:templates,   "Templates",       "◫", backoffice_templates_path],
    [:permissions, "Access",          "🛡", backoffice_permissions_path],
  ]
%>
<aside class="ds-sidebar">
  <div class="ds-sidebar__brand">
    <span class="ds-nav__mark"></span> Console
  </div>
  <div class="ds-sidebar__section">Operate</div>
  <% nav.each do |key, label, icon, path| %>
    <%= link_to path, class: "ds-sidebar__link #{'is-active' if current == key}",
          data: { testid: "nav-#{key}" } do %>
      <span class="ds-sidebar__icon"><%= icon %></span> <%= label %>
    <% end %>
  <% end %>
  <span class="ds-spacer"></span>
  <button class="ds-btn ds-btn--ghost ds-btn--sm ds-btn--block" data-ds-theme-toggle>
    ◑ <span data-ds-theme-label>Dark</span>
  </button>
  <div style="margin-top:12px;">
    <%= link_to "← Customer site", root_path, class: "ds-muted ds-xs" %>
  </div>
</aside>
