<div data-testid="positions-page">
  <h1>My Positions</h1>

  <% if @positions.empty? && @clob_positions.empty? && @lmsr_positions.empty? %>
    <div class="ds-card" style="text-align:center;padding:40px 20px;" data-testid="no-positions">
      <p class="ds-muted">No open positions.</p>
      <%= link_to "Browse markets", web_markets_path, class: "ds-btn ds-btn--primary" %>
    </div>
  <% end %>

  <% if @positions.any? %>
    <div class="ds-card ds-card--flush" style="margin-bottom:16px;">
      <div class="ds-card__head"><h3 style="margin:0;">Fixed-Odds &amp; Parimutuel Bets</h3></div>
      <table class="ds-table">
        <thead>
          <tr>
            <th>Market</th>
            <th>Side</th>
            <th style="text-align:right;">Stake</th>
            <th style="text-align:right;">Potential payout</th>
            <th style="text-align:right;">Odds</th>
          </tr>
        </thead>
        <tbody data-testid="positions-list">
          <% @positions.each do |p| %>
            <tr data-testid="position-row-<%= p[:bet_id] %>">
              <td><%= link_to p[:market_question], web_market_path(p[:market_id]), class: "ds-muted" %></td>
              <td><strong><%= p[:leg_label] %></strong></td>
              <td class="ds-num" style="text-align:right;"><%= number_with_delimiter(p[:stake_minor]) %> ADIV</td>
              <td class="ds-num" style="text-align:right;"><%= number_with_delimiter(p[:potential_payout_minor]) %> ADIV</td>
              <td class="ds-num" style="text-align:right;"><%= (p[:odds_minor] / 100.0).round(0) %>%</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <% if @clob_positions.any? %>
    <div class="ds-card ds-card--flush" style="margin-bottom:16px;">
      <div class="ds-card__head"><h3 style="margin:0;">CLOB Positions</h3></div>
      <table class="ds-table">
        <thead>
          <tr>
            <th>Market</th>
            <th style="text-align:right;">YES contracts</th>
            <th style="text-align:right;">NO contracts</th>
            <th style="text-align:right;">Avg YES price</th>
            <th style="text-align:right;">Unrealised value</th>
          </tr>
        </thead>
        <tbody data-testid="clob-positions-list">
          <% @clob_positions.each do |cp| %>
            <tr data-testid="clob-position-row-<%= cp[:market_id] %>">
              <td><%= link_to cp[:market_question], web_market_path(cp[:market_id]), class: "ds-muted" %></td>
              <td class="ds-num" style="text-align:right;"><%= cp[:yes_contracts] %></td>
              <td class="ds-num" style="text-align:right;"><%= cp[:no_contracts] %></td>
              <td class="ds-num" style="text-align:right;"><%= cp[:avg_yes_price_cents] ? "#{cp[:avg_yes_price_cents]}¢" : '—' %></td>
              <td class="ds-num" style="text-align:right;"><%= cp[:unrealised_value_minor] ? "#{number_with_delimiter(cp[:unrealised_value_minor])} ADIV" : '—' %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <% if @lmsr_positions.any? %>
    <div class="ds-card ds-card--flush" style="margin-bottom:16px;">
      <div class="ds-card__head"><h3 style="margin:0;">LMSR Positions</h3></div>
      <table class="ds-table">
        <thead>
          <tr>
            <th>Market</th>
            <th>Side</th>
            <th style="text-align:right;">Contracts</th>
          </tr>
        </thead>
        <tbody data-testid="lmsr-positions-list">
          <% @lmsr_positions.each do |position| %>
            <tr data-testid="lmsr-position-row-<%= position[:market_id] %>-<%= position[:side] %>">
              <td><%= link_to position[:market_question], web_market_path(position[:market_id]), class: "ds-muted" %></td>
              <td><strong><%= position[:side] %></strong></td>
              <td class="ds-num" style="text-align:right;"><%= number_with_delimiter(position[:contracts]) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <p><%= link_to "← Back to markets", web_markets_path, class: "ds-muted" %></p>
</div>
