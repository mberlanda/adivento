<h1>Create your account</h1>
<p class="ds-muted">Sign up to track positions, climb the leaderboard, and trade on markets.</p>

<div class="ds-card ds-container--narrow" style="margin-top:20px;">
  <%= form_with url: "/register", method: :post, html: { data: { testid: "register-form" } } do |f| %>
    <p>
      <%= f.label :email, "Email" %><br>
      <%= f.email_field :email, required: true, class: "ds-input", data: { testid: "register-email" } %>
    </p>
    <p>
      <%= f.label :password, "Password" %><br>
      <%= f.password_field :password, required: true, minlength: 8, class: "ds-input",
            data: { testid: "register-password" } %>
    </p>
    <p><%= f.submit "Create account", class: "ds-btn ds-btn--primary ds-btn--block",
          data: { testid: "register-submit" } %></p>
  <% end %>
</div>

<p class="ds-muted" style="text-align:center;margin-top:16px;">Already have an account? <%= link_to "Sign in", signin_path %></p>
