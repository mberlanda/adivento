<div style="margin-bottom:8px;">
  <%= link_to "← All Markets", web_markets_path, class: "muted" %>
</div>

<div style="display:flex;flex-wrap:wrap;gap:6px;margin-bottom:10px;" data-testid="market-meta">
  <span class="badge badge-status"><%= @market.status.capitalize %></span>
  <span class="badge" data-testid="market-category"><%= @market.category.capitalize %></span>
  <span class="badge badge-status"><%= @market.mechanism_type.upcase %></span>
  <% if @market.settled_outcome.present? %>
    <span class="badge" style="background:#fef3e2;color:#8a5c10;">Settled: <%= @market.settled_outcome %></span>
  <% end %>
</div>

<h1 style="margin:0 0 8px;font-size:1.5rem;line-height:1.3;" data-testid="market-title"><%= @market.question %></h1>
<p class="muted" style="margin:0 0 20px;"><%= @market.description %></p>

<% if @market.tags.any? %>
  <div style="margin-bottom:16px;" data-testid="market-tags">
    <%= safe_join(@market.tags.map { |t| content_tag(:span, t, class: 'badge badge-tag') }, ' ') %>
  </div>
<% end %>

<div class="stat-grid" data-testid="market-stats">
  <div class="stat-card">
    <div class="stat-label">Volume</div>
    <div class="stat-value" data-testid="market-volume"><%= number_with_delimiter(@volume_minor) %> ADIV</div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Open Positions</div>
    <div class="stat-value" data-testid="market-open-bets"><%= number_with_delimiter(@open_bet_count) %></div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Creator</div>
    <div class="stat-value" style="font-size:0.85rem;"><%= @market.created_by.email.split('@').first %></div>
  </div>
</div>

<section class="card" style="margin-bottom:16px;" data-testid="market-price-panel">
  <h3 style="margin-top:0;">Current Price</h3>
  <% case @market.mechanism_type %>
  <% when 'fixed_odds' %>
    <div style="display:flex;gap:12px;flex-wrap:wrap;">
      <% @market.market_legs.each do |leg| %>
        <div style="flex:1;min-width:100px;background:#f4f9f7;border:1px solid #d0e8de;border-radius:10px;padding:14px;text-align:center;">
          <div style="font-size:0.85rem;color:var(--muted);margin-bottom:4px;"><%= leg.label %></div>
          <div style="font-size:2rem;font-weight:800;color:var(--accent);"><%= (leg.odds_minor / 100.0).round(0) %>%</div>
          <div class="muted" style="font-size:0.75rem;"><%= (leg.odds_minor / 100.0).round(1) %>¢</div>
        </div>
      <% end %>
    </div>

  <% when 'clob' %>
    <div class="clob-display" data-testid="clob-price-display">
      <% book = @market.pricing_engine.order_book_summary %>
      <div style="display:flex;gap:12px;flex-wrap:wrap;margin-bottom:12px;">
        <div style="flex:1;min-width:100px;background:#f4f9f7;border:1px solid #d0e8de;border-radius:10px;padding:14px;text-align:center;">
          <div class="muted" style="font-size:0.8rem;">Best Bid (YES)</div>
          <div style="font-size:2rem;font-weight:800;color:var(--accent);"><%= book[:bid] ? "#{book[:bid]}¢" : "—" %></div>
        </div>
        <div style="flex:1;min-width:100px;background:#fff8f0;border:1px solid #f0dfc0;border-radius:10px;padding:14px;text-align:center;">
          <div class="muted" style="font-size:0.8rem;">Best Ask (NO)</div>
          <div style="font-size:2rem;font-weight:800;color:#8a5c10;"><%= book[:ask] ? "#{book[:ask]}¢" : "—" %></div>
        </div>
      </div>
      <% if book[:spread] %>
        <p class="muted">Spread: <%= book[:spread] %>¢<% if @market.last_fill_price_cents %> &nbsp;·&nbsp; Last trade: <%= @market.last_fill_price_cents %>¢<% end %></p>
      <% elsif book[:bid].nil? && book[:ask].nil? %>
        <p class="muted">No open orders yet — place the first order to establish prices.</p>
      <% end %>
    </div>

  <% when 'lmsr' %>
    <div class="lmsr-display" data-testid="lmsr-price-display">
      <% engine = @market.pricing_engine %>
      <div style="display:flex;gap:12px;flex-wrap:wrap;">
        <div style="flex:1;min-width:100px;background:#f4f9f7;border:1px solid #d0e8de;border-radius:10px;padding:14px;text-align:center;">
          <div class="muted" style="font-size:0.8rem;">YES</div>
          <div style="font-size:2rem;font-weight:800;color:var(--accent);"><%= engine.yes_probability %>%</div>
        </div>
        <div style="flex:1;min-width:100px;background:#fff8f0;border:1px solid #f0dfc0;border-radius:10px;padding:14px;text-align:center;">
          <div class="muted" style="font-size:0.8rem;">NO</div>
          <div style="font-size:2rem;font-weight:800;color:#8a5c10;"><%= engine.no_probability %>%</div>
        </div>
      </div>
    </div>

  <% when 'parimutuel' %>
    <div class="parimutuel-display" data-testid="parimutuel-price-display">
      <% yes_pct = Parimutuel::ParimutuelPoolService.yes_probability(@market) %>
      <% no_pct  = Parimutuel::ParimutuelPoolService.no_probability(@market) %>
      <div style="display:flex;gap:12px;flex-wrap:wrap;margin-bottom:10px;">
        <div style="flex:1;min-width:100px;background:#f4f9f7;border:1px solid #d0e8de;border-radius:10px;padding:14px;text-align:center;">
          <div class="muted" style="font-size:0.8rem;">YES Pool</div>
          <div style="font-size:2rem;font-weight:800;color:var(--accent);"><%= yes_pct %>%</div>
          <div class="muted" style="font-size:0.75rem;"><%= number_with_delimiter(@market.parimutuel_pool_yes_minor) %> ADIV</div>
        </div>
        <div style="flex:1;min-width:100px;background:#fff8f0;border:1px solid #f0dfc0;border-radius:10px;padding:14px;text-align:center;">
          <div class="muted" style="font-size:0.8rem;">NO Pool</div>
          <div style="font-size:2rem;font-weight:800;color:#8a5c10;"><%= no_pct %>%</div>
          <div class="muted" style="font-size:0.75rem;"><%= number_with_delimiter(@market.parimutuel_pool_no_minor) %> ADIV</div>
        </div>
      </div>
      <p class="muted" style="font-size:0.82rem;">Parimutuel — odds shift as pool fills. Takeout: <%= (@market.takeout_bps.to_i / 100.0).round(1) %>%</p>
    </div>
  <% end %>
</section>

<section class="card" style="margin-bottom:16px;" data-testid="market-legs-panel">
  <h3 style="margin-top:0;">Outcomes</h3>
  <div style="display:flex;gap:8px;flex-wrap:wrap;">
    <% @market.market_legs.each do |leg| %>
      <div style="flex:1;min-width:120px;border:1px solid var(--border);border-radius:8px;padding:10px 14px;" data-testid="market-leg-<%= leg.id %>">
        <strong><%= leg.label %></strong>
        <span class="muted" style="font-size:0.82rem;margin-left:6px;"><%= (leg.odds_minor / 100.0).round(1) %>% implied</span>
      </div>
    <% end %>
  </div>
</section>

<section class="card" style="margin-bottom:16px;" data-testid="market-trust-panel">
  <h3 style="margin-top:0;">About this market</h3>
  <p class="muted" style="font-size:0.85rem;">Created by <%= @market.created_by.email.split('@').first %></p>
  <% if @market.settled_outcome.present? %>
    <div style="background:#e6f7f1;border:1px solid #b8e6d6;border-radius:8px;padding:12px;margin-top:8px;">
      <strong>Settled outcome: <%= @market.settled_outcome %></strong>
    </div>
  <% end %>
  <p class="muted" style="font-size:0.82rem;margin-top:8px;">
    Live SSE stream: <a href="/sse/markets/<%= @market.id %>">/sse/markets/<%= @market.id %></a>
  </p>
</section>
