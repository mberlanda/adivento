<div style="margin-bottom:8px;">
  <%= link_to "← All Markets", web_markets_path, class: "ds-muted" %>
</div>

<div class="ds-row ds-row--wrap" style="gap:6px;margin-bottom:10px;" data-testid="market-meta">
  <% if @market.settled_outcome.present? %>
    <%= render "shared/adv_badge", status: "settled", label: "Settled: #{@market.settled_outcome}" %>
  <% else %>
    <%= render "shared/adv_badge", status: @market.status, live: @market.open? %>
  <% end %>
  <span class="ds-badge" data-testid="market-category"><%= @market.category.capitalize %></span>
  <%= render "shared/adv_mech_chip", mechanism: @market.mechanism_type %>
</div>

<h1 style="margin:0 0 8px;font-size:1.5rem;line-height:1.3;" data-testid="market-title"><%= @market.question %></h1>
<p class="ds-muted" style="margin:0 0 20px;"><%= @market.description %></p>

<% if @market.tags.any? %>
  <div style="margin-bottom:16px;" data-testid="market-tags">
    <%= safe_join(@market.tags.map { |t| content_tag(:span, t, class: 'ds-chip ds-chip--accent') }, ' ') %>
  </div>
<% end %>

<div class="ds-grid ds-grid--auto" style="margin-bottom:20px;" data-testid="market-stats">
  <div class="ds-statcard">
    <div class="ds-stat__k">Volume</div>
    <div class="ds-statcard__v ds-num" data-testid="market-volume"><%= number_with_delimiter(@volume_minor) %> ADIV</div>
  </div>
  <div class="ds-statcard">
    <div class="ds-stat__k">Open Positions</div>
    <div class="ds-statcard__v ds-num" data-testid="market-open-bets"><%= number_with_delimiter(@open_bet_count) %></div>
  </div>
  <div class="ds-statcard">
    <div class="ds-stat__k">Creator</div>
    <div class="ds-statcard__v" style="font-size:0.85rem;"><%= @market.created_by.email.split('@').first %></div>
  </div>
</div>

<section class="ds-card" style="margin-bottom:16px;" data-testid="market-price-panel">
  <div class="ds-card__head"><h3 style="margin:0;">Current Price</h3></div>
  <% case @market.mechanism_type %>
  <% when 'fixed_odds' %>
    <div class="ds-prices">
      <% @market.market_legs.each do |leg| %>
        <div class="ds-pricebox ds-pricebox--<%= leg.label.downcase == 'yes' ? 'yes' : 'no' %>">
          <div class="ds-pricebox__label"><%= leg.label %></div>
          <div class="ds-pricebox__val ds-num"><%= (leg.odds_minor / 100.0).round(0) %>%</div>
          <div class="ds-pricebox__sub ds-muted"><%= (leg.odds_minor / 100.0).round(1) %>¢</div>
        </div>
      <% end %>
    </div>

  <% when 'clob' %>
    <div data-testid="clob-price-display">
      <% book = @market.pricing_engine.order_book_summary %>
      <div class="ds-prices" style="margin-bottom:12px;">
        <div class="ds-pricebox ds-pricebox--yes">
          <div class="ds-pricebox__label">Best Bid (YES)</div>
          <div class="ds-pricebox__val ds-num"><%= book[:bid] ? "#{book[:bid]}¢" : "—" %></div>
        </div>
        <div class="ds-pricebox ds-pricebox--no">
          <div class="ds-pricebox__label">Best Ask (NO)</div>
          <div class="ds-pricebox__val ds-num"><%= book[:ask] ? "#{book[:ask]}¢" : "—" %></div>
        </div>
      </div>
      <% if book[:spread] %>
        <p class="ds-muted">Spread: <%= book[:spread] %>¢<% if @market.last_fill_price_cents %> &nbsp;·&nbsp; Last trade: <%= @market.last_fill_price_cents %>¢<% end %></p>
      <% elsif book[:bid].nil? && book[:ask].nil? %>
        <p class="ds-muted">No open orders yet — place the first order to establish prices.</p>
      <% end %>
    </div>

  <% when 'lmsr' %>
    <div data-testid="lmsr-price-display">
      <% engine = @market.pricing_engine %>
      <div class="ds-prices">
        <div class="ds-pricebox ds-pricebox--yes">
          <div class="ds-pricebox__label">YES</div>
          <div class="ds-pricebox__val ds-num"><%= engine.yes_probability %>%</div>
        </div>
        <div class="ds-pricebox ds-pricebox--no">
          <div class="ds-pricebox__label">NO</div>
          <div class="ds-pricebox__val ds-num"><%= engine.no_probability %>%</div>
        </div>
      </div>
    </div>

  <% when 'parimutuel' %>
    <div data-testid="parimutuel-price-display">
      <% yes_pct = Parimutuel::ParimutuelPoolService.yes_probability(@market) %>
      <% no_pct  = Parimutuel::ParimutuelPoolService.no_probability(@market) %>
      <div class="ds-prices" style="margin-bottom:10px;">
        <div class="ds-pricebox ds-pricebox--yes">
          <div class="ds-pricebox__label">YES Pool</div>
          <div class="ds-pricebox__val ds-num"><%= yes_pct %>%</div>
          <div class="ds-pricebox__sub ds-muted"><%= number_with_delimiter(@market.parimutuel_pool_yes_minor) %> ADIV</div>
        </div>
        <div class="ds-pricebox ds-pricebox--no">
          <div class="ds-pricebox__label">NO Pool</div>
          <div class="ds-pricebox__val ds-num"><%= no_pct %>%</div>
          <div class="ds-pricebox__sub ds-muted"><%= number_with_delimiter(@market.parimutuel_pool_no_minor) %> ADIV</div>
        </div>
      </div>
      <p class="ds-muted" style="font-size:0.82rem;">Parimutuel — odds shift as pool fills. Takeout: <%= (@market.takeout_bps.to_i / 100.0).round(1) %>%</p>
    </div>
  <% end %>
</section>

<section class="ds-card" style="margin-bottom:16px;" data-testid="market-legs-panel">
  <div class="ds-card__head"><h3 style="margin:0;">Outcomes</h3></div>
  <div style="display:flex;gap:8px;flex-wrap:wrap;padding-top:12px;">
    <% @market.market_legs.each do |leg| %>
      <div style="flex:1;min-width:120px;border:1px solid var(--ds-border);border-radius:8px;padding:10px 14px;"
           data-testid="market-leg-<%= leg.id %>">
        <strong><%= leg.label %></strong>
        <span class="ds-muted" style="font-size:0.82rem;margin-left:6px;"><%= (leg.odds_minor / 100.0).round(1) %>% implied</span>
      </div>
    <% end %>
  </div>
</section>

<% if @market.closed? %>
  <div class="ds-callout ds-callout--locked" style="margin-bottom:16px;" data-testid="market-closed-notice">
    <strong>This market is closed for new bets.</strong>
    <span class="ds-muted" style="font-size:0.88em;margin-left:6px;">Awaiting settlement by a moderator.</span>
  </div>
<% end %>

<% if @market.open? %>
  <% if current_user %>
    <% if @market.fixed_odds? %>
      <section class="ds-card" style="margin-bottom:16px;" data-testid="quick-bet-panel">
        <div class="ds-card__head"><h3 style="margin:0;">Place a Bet</h3></div>
        <div style="padding-top:12px;">
          <%= form_with url: web_market_bets_path(@market), method: :post, data: { testid: 'quick-bet-form' } do |f| %>
            <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px;">
              <% @market.market_legs.each do |leg| %>
                <label style="flex:1;min-width:100px;border:2px solid var(--ds-border);border-radius:8px;padding:10px 14px;cursor:pointer;text-align:center;">
                  <%= radio_button_tag :market_leg_id, leg.id, false, required: true, data: { testid: "bet-leg-#{leg.label.downcase}" } %>
                  <strong style="margin-left:4px;"><%= leg.label %></strong>
                  <span class="ds-muted" style="font-size:0.82rem;"> (<%= (leg.odds_minor / 100.0).round(0) %>%)</span>
                </label>
              <% end %>
            </div>
            <div style="display:flex;gap:8px;align-items:center;">
              <label class="ds-muted" style="font-size:0.88rem;white-space:nowrap;">Stake (ADIV):</label>
              <%= number_field_tag :stake_minor, 100, min: 1, class: "ds-input", style: 'width:120px;',
                    required: true, data: { testid: 'bet-stake' } %>
              <%= f.submit 'Place Bet', class: "ds-btn ds-btn--yes", style: 'white-space:nowrap;',
                    data: { testid: 'bet-submit' } %>
            </div>
          <% end %>
        </div>
      </section>
    <% elsif @market.parimutuel? %>
      <section class="ds-card" style="margin-bottom:16px;" data-testid="quick-bet-panel">
        <div class="ds-card__head"><h3 style="margin:0;">Place a Pool Bet</h3></div>
        <div style="padding-top:12px;">
          <%= form_with url: web_market_parimutuel_bets_path(@market), method: :post, data: { testid: 'quick-bet-form' } do |f| %>
            <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px;">
              <% [['YES', 'yes'], ['NO', 'no']].each do |label, val| %>
                <label style="flex:1;min-width:100px;border:2px solid var(--ds-border);border-radius:8px;padding:10px 14px;cursor:pointer;text-align:center;">
                  <%= radio_button_tag :side, val, false, required: true, data: { testid: "bet-leg-#{val}" } %>
                  <strong style="margin-left:4px;"><%= label %> Pool</strong>
                </label>
              <% end %>
            </div>
            <div style="display:flex;gap:8px;align-items:center;">
              <label class="ds-muted" style="font-size:0.88rem;white-space:nowrap;">Stake (ADIV):</label>
              <%= number_field_tag :stake_minor, 100, min: 1, class: "ds-input", style: 'width:120px;',
                    required: true, data: { testid: 'bet-stake' } %>
              <%= f.submit 'Place Stake', class: "ds-btn ds-btn--primary", style: 'white-space:nowrap;',
                    data: { testid: 'bet-submit' } %>
            </div>
          <% end %>
        </div>
      </section>
    <% elsif @market.clob? %>
      <section class="ds-card" style="margin-bottom:16px;" data-testid="quick-bet-panel">
        <div class="ds-card__head"><h3 style="margin:0;">Place Limit Order</h3></div>
        <div style="padding-top:12px;">
          <p class="ds-muted" style="font-size:0.82rem;margin-bottom:12px;">CLOB — set your price and quantity. Order stays open until filled or cancelled.</p>
          <%= form_with url: web_market_orders_path(@market), method: :post, data: { testid: 'quick-bet-form' } do |f| %>
            <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px;">
              <% [['YES (Buy)', 'yes'], ['NO (Sell)', 'no']].each do |label, val| %>
                <label style="flex:1;min-width:100px;border:2px solid var(--ds-border);border-radius:8px;padding:10px 14px;cursor:pointer;text-align:center;">
                  <%= radio_button_tag :side, val, false, required: true, data: { testid: "bet-leg-#{val}" } %>
                  <strong style="margin-left:4px;"><%= label %></strong>
                </label>
              <% end %>
            </div>
            <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
              <label class="ds-muted" style="font-size:0.88rem;white-space:nowrap;">Price (¢):</label>
              <%= number_field_tag :price_cents, 50, min: 1, max: 99, class: "ds-input",
                    style: 'width:80px;', required: true, data: { testid: 'bet-stake' } %>
              <label class="ds-muted" style="font-size:0.88rem;white-space:nowrap;">Qty:</label>
              <%= number_field_tag :quantity, 10, min: 1, class: "ds-input", style: 'width:80px;', required: true %>
              <%= f.submit 'Place Order', class: "ds-btn ds-btn--primary", style: 'white-space:nowrap;',
                    data: { testid: 'bet-submit' } %>
            </div>
          <% end %>
        </div>
      </section>
    <% elsif @market.lmsr? %>
      <section class="ds-card" style="margin-bottom:16px;" data-testid="quick-bet-panel">
        <div class="ds-card__head"><h3 style="margin:0;">Buy Shares</h3></div>
        <div style="padding-top:12px;">
          <p class="ds-muted" style="font-size:0.82rem;margin-bottom:12px;">LMSR — prices adjust automatically as you trade.</p>
          <%= form_with url: web_market_lmsr_trades_path(@market), method: :post, data: { testid: 'quick-bet-form' } do |f| %>
            <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px;">
              <% [['YES', 'yes'], ['NO', 'no']].each do |label, val| %>
                <label style="flex:1;min-width:100px;border:2px solid var(--ds-border);border-radius:8px;padding:10px 14px;cursor:pointer;text-align:center;">
                  <%= radio_button_tag :side, val, false, required: true, data: { testid: "bet-leg-#{val}" } %>
                  <strong style="margin-left:4px;"><%= label %></strong>
                </label>
              <% end %>
            </div>
            <div style="display:flex;gap:8px;align-items:center;">
              <label class="ds-muted" style="font-size:0.88rem;white-space:nowrap;">Shares:</label>
              <%= number_field_tag :quantity, 10, min: 1, class: "ds-input", style: 'width:120px;',
                    required: true, data: { testid: 'bet-stake' } %>
              <%= f.submit 'Buy Shares', class: "ds-btn ds-btn--yes", style: 'white-space:nowrap;',
                    data: { testid: 'bet-submit' } %>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>
  <% else %>
    <div class="ds-card" style="margin-bottom:16px;text-align:center;padding:20px;" data-testid="bet-signin-prompt">
      <p class="ds-muted" style="margin:0 0 12px;">Sign in to participate in this market.</p>
      <%= link_to 'Sign In', '/signin', class: 'ds-btn ds-btn--primary' %>
    </div>
  <% end %>
<% end %>

<% if @market.resolution_criteria.present? || @market.close_at.present? || @market.settled_outcome.present? %>
  <section class="ds-card" style="margin-bottom:16px;" data-testid="market-resolution-panel">
    <div class="ds-card__head"><h3 style="margin:0;">Resolution Details</h3></div>
    <div style="padding-top:12px;">
      <% if @market.close_at.present? %>
        <div class="ds-statcard" style="margin-bottom:10px;">
          <div class="ds-stat__k">Closes</div>
          <div style="font-size:0.95rem;font-weight:600;" data-testid="market-close-at">
            <%= @market.close_at.strftime('%b %d, %Y at %H:%M UTC') %>
            <% if @market.open? && @market.close_at > Time.current %>
              <span class="ds-muted" style="font-weight:400;"> (in <%= distance_of_time_in_words(Time.current, @market.close_at) %>)</span>
            <% end %>
          </div>
        </div>
      <% end %>
      <% if @market.resolution_criteria.present? %>
        <p style="margin:0 0 8px;font-size:0.88rem;"><strong>Resolution criteria</strong></p>
        <p class="ds-muted" style="font-size:0.88rem;margin:0 0 10px;" data-testid="market-resolution-criteria"><%= @market.resolution_criteria %></p>
      <% end %>
      <% if @market.resolution_source.present? %>
        <p style="margin:0;font-size:0.88rem;" class="ds-muted">Source: <strong data-testid="market-resolution-source"><%= @market.resolution_source %></strong></p>
      <% end %>
      <% if @market.settled_outcome.present? %>
        <div class="ds-callout ds-callout--accent" style="margin-top:10px;">
          <strong>Settled outcome: <%= @market.settled_outcome %></strong>
        </div>
      <% end %>
    </div>
  </section>
<% end %>

<% if current_user && @user_bets.any? %>
  <section class="ds-card" style="margin-bottom:16px;" data-testid="user-bets-panel">
    <div class="ds-card__head"><h3 style="margin:0;">Your Bets</h3></div>
    <table class="ds-table" style="margin-top:0;">
      <thead>
        <tr>
          <th>Outcome</th>
          <th style="text-align:right;">Stake</th>
          <th style="text-align:right;">Payout</th>
          <th style="text-align:right;">Status</th>
        </tr>
      </thead>
      <tbody>
        <% @user_bets.each do |bet| %>
          <tr data-testid="user-bet-<%= bet.id %>">
            <td><strong><%= bet.market_leg.label %></strong></td>
            <td class="ds-num" style="text-align:right;"><%= number_with_delimiter(bet.net_stake_minor) %> ADIV</td>
            <td class="ds-num" style="text-align:right;"><%= number_with_delimiter(bet.potential_payout_minor) %> ADIV</td>
            <td style="text-align:right;font-size:0.82rem;">
              <%= render "shared/adv_badge", status: bet.status.sub('settled_', '') %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
<% end %>

<section class="ds-card" style="margin-bottom:16px;" data-testid="market-trust-panel">
  <div class="ds-card__head"><h3 style="margin:0;">About this market</h3></div>
  <div style="padding-top:12px;">
    <p class="ds-muted" style="font-size:0.85rem;">Status: <strong><%= @market.status %></strong> &nbsp;&bull;&nbsp; Created by <%= @market.created_by.email.split('@').first %></p>
    <% if @market.settled_outcome.present? %>
      <p style="font-size:0.88rem;margin:6px 0 0;">Settled outcome: <strong><%= @market.settled_outcome %></strong></p>
    <% end %>
    <p class="ds-muted ds-xs" style="margin-top:8px;">
      SSE: <a href="/sse/markets/<%= @market.id %>" class="ds-muted">/sse/markets/<%= @market.id %></a>
    </p>
  </div>
</section>
