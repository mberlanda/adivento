<h1>Sign in</h1>
<p class="ds-muted">Use one of the seeded users or any registered account.</p>

<div class="ds-card ds-container--narrow" style="margin-top:20px;">
  <%= form_with url: "/signin", method: :post, html: { data: { testid: "signin-form" } } do |f| %>
    <p>
      <label>Email</label><br>
      <%= f.email_field :email, required: true, class: "ds-input", data: { testid: "signin-email" } %>
    </p>
    <p>
      <label>Password</label><br>
      <%= f.password_field :password, required: true, class: "ds-input", data: { testid: "signin-password" } %>
    </p>
    <p><%= f.submit "Sign in", class: "ds-btn ds-btn--primary ds-btn--block",
          data: { testid: "signin-submit" } %></p>
  <% end %>
</div>

<p class="ds-muted" style="text-align:center;margin-top:16px;">New to Adivento? <%= link_to "Create an account", "/register" %></p>
