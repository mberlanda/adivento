<!DOCTYPE html>
<html>
  <head>
    <title>Adivento Markets</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <style>
      :root { --bg: #f6f4ec; --panel: #ffffff; --ink: #18252f; --accent: #0e7c66; --muted: #5f6f79; }
      body { margin: 0; font-family: ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; background: radial-gradient(circle at 20% -20%, #d8efe6 0%, var(--bg) 45%); color: var(--ink); }
      header { display:flex; justify-content:space-between; align-items:center; padding: 16px 24px; background: rgba(255,255,255,.85); border-bottom: 1px solid #d9e2df; position: sticky; top: 0; backdrop-filter: blur(4px); }
      a { color: var(--accent); text-decoration: none; }
      .shell { max-width: 1080px; margin: 0 auto; padding: 24px; }
      .cards { display:grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; }
      .card { background: var(--panel); border: 1px solid #d9e2df; border-radius: 16px; padding: 16px; box-shadow: 0 10px 20px rgba(0,0,0,.04); }
      .muted { color: var(--muted); font-size: 0.92rem; }
      .badge { display:inline-block; padding:4px 10px; border-radius:999px; background:#ecf7f3; color:#0a5e4e; font-size:.8rem; margin-right:6px; }
      .flash { margin: 12px 0; padding: 10px 12px; border-radius: 10px; }
      .notice { background: #e6f7f1; }
      .alert { background: #fdecec; }
      input, select, textarea, button { padding: 8px 10px; border-radius: 8px; border: 1px solid #b8c8c3; }
      button { background: #0e7c66; color: white; border: 0; cursor: pointer; }
      form.inline { display: inline; }
      nav a, .nav-button { color: var(--accent); text-decoration: none; font: inherit; }
      .nav-button { background: transparent; border: 0; padding: 0; cursor: pointer; }
    </style>
  </head>
  <body>
    <header>
      <strong><a href="/" data-testid="nav-home">Adivento</a></strong>
      <nav data-testid="top-nav">
        <% if nav_action_available?("navigation.markets") %>
          <a href="<%= nav_action_path("navigation.markets") %>" data-testid="nav-markets">Markets</a>
        <% end %>
        <% if nav_action_available?("navigation.backoffice") %>
          &nbsp;|&nbsp;<a href="<%= nav_action_path("navigation.backoffice") %>" data-testid="nav-backoffice">Backoffice</a>
        <% end %>
        <% if nav_action_available?("navigation.sign_out") %>
          &nbsp;|&nbsp;
          <%= button_to "Sign out", nav_action_path("navigation.sign_out"), method: :delete, form_class: "inline", class: "nav-button", form: { data: { testid: "signout-form" } }, data: { testid: "nav-signout" } %>
        <% elsif nav_action_available?("navigation.sign_in") %>
          &nbsp;|&nbsp;<a href="<%= nav_action_path("navigation.sign_in") %>" data-testid="nav-signin">Sign in</a>
        <% end %>
      </nav>
    </header>
    <main class="shell">
      <% if notice.present? %><div class="flash notice"><%= notice %></div><% end %>
      <% if alert.present? %><div class="flash alert"><%= alert %></div><% end %>
      <%= yield %>
    </main>
  </body>
</html>
