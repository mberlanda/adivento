<!DOCTYPE html>
<html data-theme="dark">
  <head>
    <title>Adivento Backoffice</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#0F5136">
    <%= favicon_link_tag "adivento/favicon.svg", type: "image/svg+xml" %>
    <%= tag.link rel: "apple-touch-icon", href: asset_path("adivento/app-icon.svg") %>
    <%= stylesheet_link_tag "adivento" %>
  </head>
  <body class="ds-app">
    <div class="ds-shell">
      <%= render "backoffice/shared/sidebar" %>
      <main class="ds-main">
        <% if notice.present? %>
          <div class="ds-callout ds-callout--accent" style="margin-bottom:16px;" data-testid="flash-notice"><%= notice %></div>
        <% end %>
        <% if alert.present? %>
          <div class="ds-callout ds-callout--warn" style="margin-bottom:16px;" data-testid="flash-alert"><%= alert %></div>
        <% end %>
        <%= yield %>
      </main>
    </div>
    <%= javascript_include_tag "adivento", defer: true %>
  </body>
</html>
