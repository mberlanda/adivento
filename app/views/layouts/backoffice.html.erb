<!DOCTYPE html>
<html>
  <head>
    <title>Adivento Backoffice</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="stylesheet" href="/adivento.css">
  </head>
  <body class="adv-app" data-theme="dark">
    <div class="adv-shell">
      <%= render "backoffice/shared/sidebar" %>
      <main class="adv-main">
        <% if notice.present? %>
          <div class="adv-callout adv-callout--accent" style="margin-bottom:16px;" data-testid="flash-notice"><%= notice %></div>
        <% end %>
        <% if alert.present? %>
          <div class="adv-callout adv-callout--warn" style="margin-bottom:16px;" data-testid="flash-alert"><%= alert %></div>
        <% end %>
        <%= yield %>
      </main>
    </div>
    <script src="/adivento.js" defer></script>
  </body>
</html>
