<!DOCTYPE html>
<html data-theme="dark">
  <head>
    <title>Adivento Backoffice</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="stylesheet" href="<%= adivento_asset_path("adivento.css") %>">
  </head>
  <body class="adv-app">
    <div class="ops-shell">
      <%= render "backoffice/shared/sidebar" %>
      <main class="ops-main">
        <% if notice.present? %>
          <div class="adv-callout adv-callout--accent" style="margin-bottom:16px;" data-testid="flash-notice"><%= notice %></div>
        <% end %>
        <% if alert.present? %>
          <div class="adv-callout adv-callout--warn" style="margin-bottom:16px;" data-testid="flash-alert"><%= alert %></div>
        <% end %>
        <%= yield %>
      </main>
    </div>
    <script src="<%= adivento_asset_path("adivento.js") %>" defer></script>
  </body>
</html>
